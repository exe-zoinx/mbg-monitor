# MBG Monitor - Local Environment Variables
# Copy to .env and fill in your keys

# Tavily Search API (AI-optimized search)
TAVILY_API_KEY=tvly-dev-REPLACED

# Exa Neural Search API
EXA_API_KEY=exa-REPLACED

# Firecrawl Web Scraping API
FIRECRAWL_API_KEY=fc-REPLACED

# Gemini AI API (for article summarization)
AI_API_KEY=

# Cron secret for manual trigger
CRON_SECRET=cron-secret-REPLACED
