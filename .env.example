# MBG Monitor - Environment Variables Template
# Copy this to .env and fill in your values

# AI API Key (Google AI Studio)
# Get yours at: https://aistudio.google.com/app/apikey
AI_API_KEY=your-google-ai-key-here

# Cron Secret (min 32 chars)
# Generate with: openssl rand -hex 20
CRON_SECRET=your-random-secret-here

# Pages Origin (your Cloudflare Pages URL)
PAGES_ORIGIN=https://your-project.pages.dev
